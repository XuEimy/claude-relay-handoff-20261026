# 本地预览不需要真实凭据。模型渠道与费率在管理后台配置。
HOST=127.0.0.1
PORT=4174
DATABASE_PATH=data/kelaodeyun.db
REGISTRATION_OPEN=true
ANTHROPIC_VERSION=2026-10-21
ANTHROPIC_WORKSPACE_ID=
# 生产环境必填；DATA_ENCRYPTION_KEY 为 32 字节随机数的 64 位 hex 编码。
# 本地自动生成的 data/encryption.key 必须与数据库一起安全备份。
PUBLIC_ORIGIN=
DATA_ENCRYPTION_KEY=
SETUP_TOKEN=
PUBLIC_OPERATOR=
SUPPORT_EMAIL=
ICP_NUMBER=
SECURITY_FILING_NUMBER=
# 支付宝：需开通电脑网站支付；移动跳转还需手机网站支付权限。
ALIPAY_APP_ID=
ALIPAY_SELLER_ID=
ALIPAY_PRIVATE_KEY=
ALIPAY_PUBLIC_KEY=
ALIPAY_SANDBOX=true
# 微信：普通商户 Native 支付，公钥模式。API v3 密钥为 32 字符。
WECHAT_APP_ID=
WECHAT_MCH_ID=
WECHAT_SERIAL_NO=
WECHAT_PRIVATE_KEY=
WECHAT_PUBLIC_KEY=
WECHAT_PUBLIC_KEY_ID=
WECHAT_API_V3_KEY=
