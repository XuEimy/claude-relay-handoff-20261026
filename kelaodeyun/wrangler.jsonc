{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "kelaodeyun",
  "main": "worker/index.js",
  "compatibility_date": "2026-08-22",
  "triggers": { "crons": ["*/5 * * * *"] },
  "routes": [{ "pattern": "kelaodeyun.com", "custom_domain": true }],
  "assets": { "directory": "./dist/client", "binding": "ASSETS", "not_found_handling": "single-page-application", "run_worker_first": true },
  "durable_objects": { "bindings": [{ "name": "STORE", "class_name": "Store" }] },
  "migrations": [{ "tag": "v1", "new_sqlite_classes": ["Store"] }],
  "workflows": [
    { "name": "provision-server", "binding": "PROVISION", "class_name": "ProvisionServer" },
    { "name": "teardown-server", "binding": "TEARDOWN", "class_name": "TeardownServer" }
  ],
  "vars": {
    "PUBLIC_ORIGIN": "https://kelaodeyun.com",
    "ADMIN_EMAILS": "821819569@qq.com",
    "CONTABO_MODE": "simulate",
    "PRICE_MULTIPLIER": "1.5",
    "CONTABO_IMAGE_ID": "d64d5c6c-9dda-4e38-8174-0ee282474d8a",
    "SUPPORT_EMAIL": "",
    "PUBLIC_OPERATOR": ""
  }
}
